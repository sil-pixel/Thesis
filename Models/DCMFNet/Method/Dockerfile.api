FROM python:3.12-slim

WORKDIR /app
COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

# Deliberately copy only package-level inference modules. The nested
# dcmfnet/training package, audit metadata, and datasets never enter the image.
COPY dcmfnet/*.py ./dcmfnet/

RUN useradd --create-home --uid 10001 dcmfnet
USER dcmfnet

# Supply only the .pt artifact through a read-only /model volume at runtime.
EXPOSE 8000
CMD ["python", "-m", "dcmfnet.api", "--artifact", "/model/dcmfnet.pt", "--host", "0.0.0.0", "--port", "8000"]
